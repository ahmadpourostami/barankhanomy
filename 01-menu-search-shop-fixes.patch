index 3cdafa7..30ebf72 100644
--- a/wp-content/themes/baran-khanomy/functions.php
+++ b/wp-content/themes/baran-khanomy/functions.php
@@ -13,6 +13,22 @@ add_action( 'after_setup_theme', function() {
     register_nav_menus( array( 'primary' => 'منوی اصلی' ) );
 } );
 
+/**
+ * Anchor links like #courses/#about only exist on the front page. On every
+ * other page (shop, courses archive, a single course, etc.) they used to
+ * point nowhere. Rewrite any nav-menu URL that is a bare "#anchor" to the
+ * front page + anchor, so the same menu works from any page on the site.
+ */
+add_filter( 'wp_nav_menu_objects', function( $items ) {
+    $home = home_url( '/' );
+    foreach ( $items as $item ) {
+        if ( isset( $item->url ) && 0 === strpos( $item->url, '#' ) ) {
+            $item->url = $home . $item->url;
+        }
+    }
+    return $items;
+} );
